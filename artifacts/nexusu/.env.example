# Reown (WalletConnect) — optional; enables mobile wallet selection from Chrome/Safari.
# Create a free project at https://dashboard.reown.com
VITE_WALLETCONNECT_PROJECT_ID=your_reown_project_id

# Circle user-controlled wallets (email OTP + PIN) — public App ID only.
# console.circle.com → Programmable Wallets → User-Controlled → App Settings
VITE_CIRCLE_UC_APP_ID=your_circle_uc_app_id

# Backend base URL for /api/uc/* (leave empty in local dev to use Vite proxy → :8080)
# On Vercel, leave unset so the browser calls same-origin /api/* (rewritten to the serverless function).
# VITE_API_URL=https://your-api.example.com

# CooperativeTreasuryVault on Arc (after forge deploy)
# Per-cooperative vaults + loan pools (recommended)
# VITE_TREASURY_VAULT_FACTORY_ADDRESS=0x...
# VITE_LOAN_POOL_FACTORY_ADDRESS=0x...
# Legacy single shared vault/pool (do NOT use with multiple workspaces — balances leak)
# VITE_TREASURY_VAULT_ADDRESS=0x...
# VITE_LOAN_POOL_ADDRESS=0x...

# CooperativeLoanPool on Arc (after forge deploy)
# VITE_LOAN_POOL_ADDRESS=0x...

# CooperativeRegistry + RotationManager (after DeployRegistry.s.sol)
# VITE_COOPERATIVE_REGISTRY_ADDRESS=0x...
# VITE_ROTATION_MANAGER_ADDRESS=0x...

# ── Vercel (Project → Settings → Environment Variables) ──────────────────────
# Build-time (VITE_* must be available at Build):
#   VITE_WALLETCONNECT_PROJECT_ID
#   VITE_CIRCLE_UC_APP_ID
#   VITE_TREASURY_VAULT_ADDRESS
#   VITE_LOAN_POOL_ADDRESS
#   VITE_COOPERATIVE_REGISTRY_ADDRESS
#   VITE_ROTATION_MANAGER_ADDRESS
# Runtime (server /api — see api-server/.env.example):
#   DATABASE_URL          ← required for durable cooperatives (Postgres)
#   CIRCLE_UC_API_KEY
#   CIRCLE_UC_BLOCKCHAIN=ARC-TESTNET
#   CIRCLE_UC_ACCOUNT_TYPE=SCA
#   TREASURY_VAULT_ADDRESS + VAULT_OPERATOR_PRIVATE_KEY
#     (deploy key) so Circle wallets can self-register on the vault — Circle
#     addresses differ from the forge EOA that deployed the contract.
