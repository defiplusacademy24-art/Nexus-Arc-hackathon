# Required for local long-running process (optional on Vercel serverless; defaults to 8080)
PORT=8080

# Circle user-controlled wallets (email OTP + PIN) — SERVER ONLY, never expose to the browser.
# console.circle.com → API Keys (Programmable Wallets / Web3 Services)
CIRCLE_UC_API_KEY=TEST_API_KEY:your_key_here

# Optional: entity secret (only needed for some Circle console ops / older flows)
# CIRCLE_UC_ENTITY_SECRET=your_64_char_entity_secret

# Optional overrides (defaults are Arc Testnet SCA)
# CIRCLE_UC_BLOCKCHAIN=ARC-TESTNET
# CIRCLE_UC_ACCOUNT_TYPE=SCA

# ── Vercel ────────────────────────────────────────────────────────────────────
# Add CIRCLE_UC_API_KEY (and optional CIRCLE_UC_*) as Environment Variables on the
# Vercel project. They are available to the /api serverless function at runtime.
#
# Optional:
#   CORS_ORIGIN=https://your-app.vercel.app   # comma-separated if multi-origin
#   DATA_DIR=/tmp/nexusu-data                # default on Vercel is /tmp (ephemeral)
#   LOG_LEVEL=info
#
# Note: the JSON file store under /tmp is ephemeral on serverless (cold starts /
# multiple instances do not share durable disk). Fine for demos; use a real DB for production.
