# Required for local long-running process (optional on Vercel serverless; defaults to 8080)
PORT=8080

# ── Durable data (REQUIRED for production / Vercel) ───────────────────────────
# Postgres connection string (Vercel Postgres, Neon, Supabase, Railway, etc.).
# When set, cooperatives / members / transactions / notifications persist across
# redeploys and devices. When unset, the API falls back to an ephemeral JSON file
# (local demo only — on Vercel that file lives in /tmp and is wiped often).
#
# DATABASE_URL=postgresql://user:password@host:5432/nexusu?sslmode=require
#
# After setting DATABASE_URL the first time, either:
#   pnpm --filter @workspace/db run push
# or let the API auto-create tables on first request (ensureSchema).

# Circle user-controlled wallets (email OTP + PIN) — SERVER ONLY, never expose to the browser.
# console.circle.com → API Keys (Programmable Wallets / Web3 Services)
CIRCLE_UC_API_KEY=TEST_API_KEY:your_key_here

# Optional: entity secret (only needed for some Circle console ops / older flows)
# CIRCLE_UC_ENTITY_SECRET=your_64_char_entity_secret

# Optional overrides (defaults are Arc Testnet SCA)
# CIRCLE_UC_BLOCKCHAIN=ARC-TESTNET
# CIRCLE_UC_ACCOUNT_TYPE=SCA

# ── Vercel ────────────────────────────────────────────────────────────────────
# Add these as Environment Variables on the Vercel project (Production + Preview):
#   DATABASE_URL              ← required for durable coops/members
#   CIRCLE_UC_API_KEY
#   CIRCLE_UC_BLOCKCHAIN=ARC-TESTNET   (optional)
#   CIRCLE_UC_ACCOUNT_TYPE=SCA         (optional)
#   CORS_ORIGIN=https://your-app.vercel.app   (optional, multi-origin comma-separated)
#   LOG_LEVEL=info
#
# Without DATABASE_URL, data is stored under /tmp and will disappear.
