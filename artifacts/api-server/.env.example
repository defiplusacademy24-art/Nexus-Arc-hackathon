# Required for local long-running process (optional on Vercel serverless; defaults to 8080)
PORT=8080

# ── Durable data (REQUIRED for production / Vercel) ───────────────────────────
# Postgres connection string (Vercel Postgres, Neon, Supabase, Railway, etc.).
# When set, cooperatives / members / transactions / notifications persist across
# redeploys and devices. When unset, the API falls back to an ephemeral JSON file
# (local demo only — on Vercel that file lives in /tmp and is wiped often).
#
# DATABASE_URL=postgresql://user:password@host:5432/nexusu?sslmode=require
#
# After setting DATABASE_URL the first time, either:
#   pnpm --filter @workspace/db run push
# or let the API auto-create tables on first request (ensureSchema).

# Circle user-controlled wallets (email OTP + PIN) — SERVER ONLY, never expose to the browser.
# console.circle.com → API Keys (Programmable Wallets / Web3 Services)
CIRCLE_UC_API_KEY=TEST_API_KEY:your_key_here

# Optional: entity secret (only needed for some Circle console ops / older flows)
# CIRCLE_UC_ENTITY_SECRET=your_64_char_entity_secret

# Optional overrides (defaults are Arc Testnet SCA)
# CIRCLE_UC_BLOCKCHAIN=ARC-TESTNET
# CIRCLE_UC_ACCOUNT_TYPE=SCA

# ── Arc vault bootstrap (recommended if you keep the existing vault) ──────────
# Circle login addresses differ from the forge deploy EOA. When a user creates or
# joins a cooperative (or deposits), the API uses this key to call registerMember
# so they can contribute with no extra UI step.
#
# Keep the deploy key as on-chain organizer (do not transferOrganizer away).
# Testnet only — never put a mainnet private key here.
#
# TREASURY_VAULT_ADDRESS=0xe287D1acD501ec2A954BA030B7387de12D248E02
# VAULT_OPERATOR_PRIVATE_KEY=0x...   # PRIVATE_KEY used for forge deploy
# ARC_RPC_URL=https://rpc.testnet.arc.network

# ── Vercel ────────────────────────────────────────────────────────────────────
# Add these as Environment Variables on the Vercel project (Production + Preview):
#   DATABASE_URL              ← required for durable coops/members
#   CIRCLE_UC_API_KEY
#   CIRCLE_UC_BLOCKCHAIN=ARC-TESTNET   (optional)
#   CIRCLE_UC_ACCOUNT_TYPE=SCA         (optional)
#   TREASURY_VAULT_ADDRESS     ← vault on Arc (same as VITE_TREASURY_VAULT_ADDRESS)
#   VAULT_OPERATOR_PRIVATE_KEY ← deploy key so Circle wallets can self-register
#   ARC_RPC_URL                ← optional; defaults to Arc testnet public RPC
#   CORS_ORIGIN=https://your-app.vercel.app   (optional, multi-origin comma-separated)
#   LOG_LEVEL=info
#
# Without DATABASE_URL, data is stored under /tmp and will disappear.

# ── Autonomous multi-agent runtime (dedicated worker; never Vercel serverless) ─
# Long-running process only (pnpm --filter @workspace/api-server start).
# Agents never store money — funds stay in smart contracts on Arc.
#
# AGENTS_ENABLED=false
# CIRCLE_BIN=/usr/local/bin/circle
#
# SpaceXAI (xAI) for agent decisions + Nexa assistant (preferred)
# XAI_API_KEY=xai-...
# XAI_AGENT_MODEL=grok-4.5
# XAI_BASE_URL=https://api.x.ai/v1
#
# Fallback (OpenAI-compatible) if XAI_API_KEY is unset:
# OPENAI_API_KEY=
# OPENAI_AGENT_MODEL=gpt-4.1
#
# Deployed Arc contracts (required when AGENTS_ENABLED=true)
# COOPERATIVE_REGISTRY_ADDRESS=0x...
# TREASURY_VAULT_ADDRESS=0x...
# LOAN_POOL_ADDRESS=0x...
# ROTATION_MANAGER_ADDRESS=0x...
#
# Independent Circle Agent Wallets (never share; never put seed phrases here)
# CIRCLE_AGENT_WALLET_TREASURY_ADDRESS=0x...
# CIRCLE_AGENT_WALLET_CONTRIBUTION_ADDRESS=0x...
# CIRCLE_AGENT_WALLET_ROTATION_ADDRESS=0x...
# CIRCLE_AGENT_WALLET_LOAN_ADDRESS=0x...
# CIRCLE_AGENT_WALLET_SAVINGS_ADDRESS=0x...
# CIRCLE_AGENT_WALLET_GOVERNANCE_ADDRESS=0x...
# CIRCLE_AGENT_WALLET_FRAUD_ADDRESS=0x...
# CIRCLE_AGENT_WALLET_NEXA_ADDRESS=0x...
# CIRCLE_AGENT_WALLET_NOTIFICATION_ADDRESS=0x...
#
# AGENT_POLL_INTERVAL_MS=12000
# AGENT_MAX_RETRIES=5
# AGENT_RATE_LIMIT_WINDOW_MS=60000
# AGENT_RATE_LIMIT_MAX_WALLET_CALLS=10
