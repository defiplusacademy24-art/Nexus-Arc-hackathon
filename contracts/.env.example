# Deployer private key (never commit real keys)
# Copy this file to .env and set your key there only.
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Arc Testnet RPC (primary)
ARC_RPC_URL=https://rpc.testnet.arc.network

# Existing deployed contracts (do not redeploy unless required)
TREASURY_VAULT_ADDRESS=0x...
LOAN_POOL_ADDRESS=0x...
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Optional deploy overrides
# ORGANIZER=0x...
# ADMIN=0x...
# COOP_NAME=Sunrise Savings Circle
# CONTRIBUTION_AMOUNT=100000000
# Default product policy: 60% / 30% / 5% / 5%
# ROTATION_BPS=6000
# LOAN_POOL_BPS=3000
# EMERGENCY_BPS=500
# SAVINGS_BPS=500
# REGISTER_ORGANIZER=true
